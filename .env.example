# NYAYA AI — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local. NEVER paste secret keys into chat.

# --- Supabase (Phase 2) — Supabase dashboard → Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
# Public key (called "anon" or "publishable"). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET key (called "service_role" or "secret"). Server/admin scripts only.
# Must never start with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (free tiers). Server only — never prefix with NEXT_PUBLIC_. ---
# Groq key: console.groq.com -> API Keys (starts with gsk_)
GROQ_API_KEY=
# Gemini key: aistudio.google.com -> Get API key
# FREE TIER: Google may use submitted content to improve its products.
# Use only made-up test data on free tiers.
GEMINI_API_KEY=
# Chat/extraction models, tried in order when one is busy or out of quota.
AI_CHAT_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite
# Document reading (Phase 7): Gemini only, because it reads images and PDFs. Optional.
AI_DOCUMENT_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite
# Legal search embeddings (Phase 10). Must support 1536 dimensions.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_MB=10
# Comma-separated emails allowed to run legal knowledge-base ingestion (Phase 10)
ADMIN_EMAILS=

# --- Database connection for applying migrations (Phase 3) ---
# Supabase dashboard -> Connect (top bar) -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password. Server/CLI only.
SUPABASE_DB_URL=
