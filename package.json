{
  "name": "nyaya-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node --env-file=.env.local scripts/check-env.mjs",
    "check:auth-link": "node --env-file=.env.local scripts/check-auth-link.mjs",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run -c vitest.integration.config.mts",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "samples": "node scripts/make-sample-docs.mjs",
    "legal:extract": "node scripts/legal-extract.mjs",
    "legal:ingest": "node --env-file=.env.local scripts/legal-ingest.mjs",
    "legal:verify": "node --env-file=.env.local scripts/legal-verify.mjs",
    "test:ai": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run -c vitest.ai.config.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
